params {
    // TODO nf-core: Specify your pipeline's command line flags
    // Input options
    input                      = null

    // Boilerplate options
    outdir                     = "output"
    store_dir                  = "store_dir"
    trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    tracedir                   = "${params.outdir}/pipeline_info/${params.trace_report_suffix}"
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = 'genomes'

    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    help = false
    version = false
    wfversion = "v0.0.2"

    climb = false
    local = false

    // Add parameters here for your script
    unique_id = null
    bam_csv = null
    fastq = null
    fastq2 = null          // second file of a pair, with --fastq
    fastq_pairs_csv = null // sample_id,fastq_1,fastq_2
    paired = false         // a --bam_csv BAM/CRAM holds read pairs (FASTQ pairs need no flag)
    cram_ref = null        // reference FASTA a CRAM input was aligned to
    fastq_dir = null
    db = null
    // charon index with only the host category, used by --charon_host_only
    db_host_only = null
    charon_container = 'docker.io/rmcolq/charon:v1.1.5'
    read_type = "ont"
    deacon_index = "panhuman-1"

    charon_report = null
    refs = "resources/T2T_ref_plus_EBV_fungi_mycoplasma.fa.gz"
    ref_bed = "resources/T2T_ref.bed"
    // BLAST database: its path without extensions (e.g. /db/blast/core_nt), or a directory holding one called nt
    blast_db = null
    // Hits kept per read for each BLAST search; the best human and non-human hits are chosen by bitscore
    blast_max_targets = 25
    // Threads for each local BLAST task (a remote search uses one); they split the database between them
    blast_threads = 16
    // Also search with human (taxid 9606) excluded, to find the best non-human hit for leak tier 4
    blast_nonhuman = true
    // The reads of all samples and methods are searched together. Reads per search (default: 20 for a remote
    // search, which should not send NCBI everything at once; 5000 for a local one, as each search reads the
    // whole database), an optional cap on the reads searched per sample and method (a random sample), and whether
    // per-read results are kept in <store_dir>/blast_cache so a read is only searched once. Without --blast_db the
    // search is remote (NCBI).
    blast_chunk_reads = null
    blast_max_reads = null
    blast_cache = true
    // longest a single remote BLAST search may take before it counts as a failed attempt (GNU timeout format)
    blast_remote_timeout = '20m'
    // Leak tier thresholds: tier 3 needs a human hit with this query coverage (%) and identity (%),
    // tier 4 needs the human bitscore to be this multiple of the best non-human bitscore
    blast_min_cov = 80
    blast_min_pident = 90
    blast_bitscore_ratio = 1.1
    // Optional file of extra reference accessions (e.g. Mycoplasma) which are real contaminants, not human
    contaminant_accs = null
    charon_chunk_size = 250000
    chunk_size = 50000


    // Disk control: at most this many samples are in flight; slots live in slot_dir (absolute,
    // on a filesystem shared with the Nextflow head process). Stale slots expire after slot_timeout minutes.
    max_concurrent_samples = 1
    slot_dir = "${System.getProperty('user.dir')}/.charon_slots"
    slot_timeout = 1440
    reset_slots = true
    eager_cleanup = true
    s3_anonymous = false

    // Maximum number of reads classed as host that are mapped to the reference (4 FASTQ lines each)
    host_eval_reads = 250000
    // Keep the reads each method calls microbial in <outdir>/<sample>/reads, and, for charon, the reads it leaves
    // unclassified (which are also mapped to the reference, see map_unclassified), to look into them later
    publish_reads = true
    map_unclassified = true
    evaluate_host = false
    evaluate_microbial = false
    charon = false
    // charon with an index of only the host, as a like-for-like comparator with deacon and nohuman
    charon_host_only = false
    deacon = false
    // deacon with an absolute threshold of 1 and no relative threshold (-a 1 -r 0), as a separate comparator
    deacon_sensitive = false
    nohuman = false
    
    validate_params = true
    show_hidden_params = false

    schema_ignore_params = 'show_hidden_params,validate_params,monochrome_logs,aws_queue,aws_image_prefix,pangolin_version,wfversion,wf,process_label'

}
