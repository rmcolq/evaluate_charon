params {
    // Output options
    outdir                     = "output"
    store_dir                  = "store_dir"
    trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    tracedir                   = "${params.outdir}/pipeline_info/${params.trace_report_suffix}"

    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    // Add parameters here for your script
    unique_id = null
    bam_csv = null
    fastq = null
    fastq2 = null          // second file of a pair, with --fastq
    fastq_csv = null       // sample_id,fastq_1,fastq_2[,shuffle] (fastq_2 empty for single-end reads; shuffle=true to shuffle the reads first)
    shuffle_seed = 11      // seed for the shuffle column of --fastq_csv
    paired = false         // a --bam_csv BAM/CRAM holds read pairs (FASTQ pairs need no flag)
    cram_ref = null        // reference FASTA a CRAM input was aligned to
    fastq_dir = null
    db = null
    // charon index with only the host category, used by --charon_host_only
    db_host_only = null
    charon_container = 'docker.io/rmcolq/charon:v1.1.5'
    // extra options for charon dehost (its defaults apply otherwise), e.g. "--confidence 10"
    charon_args = ''
    read_type = "ont"
    deacon_index = "panhuman-1"

    refs = "resources/T2T_ref_plus_EBV_fungi_mycoplasma.fa.gz"
    ref_bed = "resources/T2T_ref.bed"
    // BLAST database: its path without extensions (e.g. /db/blast/core_nt), or a directory holding one called nt
    blast_db = null
    // Optional human genome BLAST database (e.g. NCBI's human_genome) for the best human hit; core_nt has no
    // eukaryotic chromosomes, so its human hits are only clones and short records. Path as for --blast_db.
    blast_human_db = null
    // Hits kept per read for each BLAST search; the best human and non-human hits are chosen by bitscore
    blast_max_targets = 25
    // Threads for each local BLAST task (a remote search uses one); they split the database between them
    blast_threads = 16
    // Also search with human (taxid 9606) excluded, to find the best non-human hit for leak tier 4
    blast_nonhuman = true
    // reads per search: default 5000 local, 20 remote
    blast_chunk_reads = null
    // search a fixed random sample of this many reads per sample and method
    blast_max_reads = null
    blast_cache = true
    // longest a single remote BLAST search may take before it counts as a failed attempt (GNU timeout format)
    blast_remote_timeout = '20m'
    // Leak tier thresholds. Tier 2 needs the human alignment to cover this fraction of the read (primary plus
    // supplementary) with at least this MAPQ: a microbial read with a short or ambiguous hit to T2T is not a leak.
    leak_min_aligned_prop = 0.5
    leak_min_mapq = 10
    // Tier 3 needs a human BLAST hit with this query coverage (%) and identity (%); null: 80 and 90 for Illumina,
    // 50 and 70 for nanopore. Tier 4 needs the human bitscore to be this multiple of the best non-human bitscore.
    blast_min_cov = null
    blast_min_pident = null
    blast_bitscore_ratio = 1.1
    // blastn -task; null: megablast for Illumina, dc-megablast for nanopore
    blast_task = null
    // Optional file of extra reference accessions (e.g. Mycoplasma) which are real contaminants, not human
    contaminant_accs = null
    chunk_size = 50000

    // at most this many samples in flight, to limit disk use (see modules/gate.nf)
    max_concurrent_samples = 1
    slot_dir = "${System.getProperty('user.dir')}/.charon_slots"
    slot_timeout = 1440
    reset_slots = true
    eager_cleanup = true
    s3_anonymous = false

    // Maximum number of reads classed as host that are mapped to the reference (4 FASTQ lines each)
    host_eval_reads = 250000
    // keep the reads each method calls microbial (and charon leaves unclassified) in <outdir>/<sample>/reads
    publish_reads = true
    map_unclassified = true
    evaluate_host = false
    evaluate_microbial = false
    charon = false
    // charon with an index of only the host, as a like-for-like comparator with deacon and nohuman
    charon_host_only = false
    deacon = false
    // deacon with an absolute threshold of 1 and no relative threshold (-a 1 -r 0), as a separate comparator
    deacon_sensitive = false
    nohuman = false
}
