/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/tmp Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // TODO nf-core: Check the defaults for all processes
    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and re-use the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_medium_plus_mem {
        cpus   = { 6     * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    // Memory sized to what the tools use (peak_rss in execution_trace.txt), not to the label, so that
    // several methods can run side by side on one machine. Charon holds its whole index in memory
    // (7.1 GB for the full nanopore index), so keep this above the index size. A retry doubles it.
    withName: 'run_charon|run_charon_chunk|run_nohuman' {
        memory = { 16.GB * task.attempt }
    }
    withName: 'run_deacon' {
        memory = { 12.GB * task.attempt }
    }
    // Remote blast uses almost no memory; a local nt database needs far more.
    withName: 'blastn_microbial_host_hits' {
        memory = { (params.blast_db ? 64.GB : 4.GB) * task.attempt }
    }
    // Per-sample stages: retry once on signals, otherwise give up on this sample only (freeing its
    // slot) so that the other samples and methods carry on.
    withName: 'bam_to_fastq|stage_fastq|run_charon|run_deacon|run_nohuman|collect_classifications|minimap2_microbial_chunk|minimap2_host|cat_all_microbial_sam_files|extract_microbial_host_hits|blastn_microbial_host_hits|merge_blast_results|evaluate_summary' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt <= 1 ? 'retry' : SampleGate.failSample(task, params.slot_dir) }
    }
    // acquire_slot (modules/gate.nf) waits for earlier samples to finish, which can take many hours, so
    // it must not inherit the short default limit of its label.
    // They also only sleep and make directories, so they must take almost no cpu or memory: the local
    // executor only starts a task when its resources are free, and a waiting acquire_slot that held a
    // normal allocation would stop the running sample's own tasks from starting (a deadlock).
    withName: 'acquire_slot|release_slot' {
        cpus   = 1
        memory = 128.MB
    }
    withName: 'acquire_slot' {
        time = 240.h
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
