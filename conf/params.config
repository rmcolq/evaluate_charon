params {
    // TODO nf-core: Specify your pipeline's command line flags
    // Input options
    input                      = null

    // Boilerplate options
    outdir                     = "output"
    store_dir                  = "store_dir"
    trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    tracedir                   = "${params.outdir}/pipeline_info/${trace_report_suffix}"
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = 'genomes'

    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    help = false
    version = false
    wfversion = "v0.0.2"

    climb = false
    local = false

    // Add parameters here for your script
    unique_id = null
    bam_csv = null
    fastq = null
    fastq_dir = null
    db = null
    read_type = "ont"
    deacon_index = "https://objectstorage.uk-london-1.oraclecloud.com/n/lrbvkel2wjot/b/human-genome-bucket/o/deacon/3/panhuman-1.k31w15.idx"

    charon_report = null
    refs = "resources/T2T_ref_plus_EBV_fungi_mycoplasma.fa.gz"
    ref_bed = "resources/T2T_ref.bed"
    blast_db = null
    // Hits kept per read for each BLAST search; the best human and non-human hits are chosen by bitscore
    blast_max_targets = 25
    // Also search with human (taxid 9606) excluded, to find the best non-human hit for leak tier 4
    blast_nonhuman = true
    // Leak tier thresholds: tier 3 needs a human hit with this query coverage (%) and identity (%),
    // tier 4 needs the human bitscore to be this multiple of the best non-human bitscore
    blast_min_cov = 80
    blast_min_pident = 90
    blast_bitscore_ratio = 1.1
    // Optional file of extra reference accessions (e.g. Mycoplasma) which are real contaminants, not human
    contaminant_accs = null
    charon_chunk_size = 250000
    chunk_size = 50000


    // Disk control: at most this many samples are in flight; slots live in slot_dir (absolute,
    // on a filesystem shared with the Nextflow head process). Stale slots expire after slot_timeout minutes.
    max_concurrent_samples = 1
    slot_dir = "${System.getProperty('user.dir')}/.charon_slots"
    slot_timeout = 1440
    reset_slots = true
    eager_cleanup = true
    s3_anonymous = false

    // Maximum number of reads classed as host that are mapped to the reference (4 FASTQ lines each)
    host_eval_reads = 250000
    evaluate_host = false
    evaluate_microbial = false
    charon = false
    deacon = false
    // deacon with an absolute threshold of 1 and no relative threshold (-a 1 -r 0), as a separate comparator
    deacon_sensitive = false
    nohuman = false
    
    validate_params = true
    show_hidden_params = false

    schema_ignore_params = 'show_hidden_params,validate_params,monochrome_logs,aws_queue,aws_image_prefix,pangolin_version,wfversion,wf,process_label'

}
