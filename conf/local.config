params {
    // Max resource options for a 16GB / 8 core laptop.
    // Docker Desktop must be given at least this much memory (it was 11.67GB when last checked).
    max_memory                 = '11.GB'
    max_cpus                   = 8
    max_time                   = '24.h'

    // Keep host mapping short on a laptop
    host_eval_reads            = 10000

}
